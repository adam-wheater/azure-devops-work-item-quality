{
    "manifestVersion": 1,
    "id": "work-item-quality",
    "version": "1.0.0",
    "name": "Work Item Quality Analyzer",
    "description": "Analyzes work item quality across sprints, detecting missing fields, stuck items, scope changes, and more.",
    "publisher": "adam-wheater",
    "categories": [
        "Azure Boards"
    ],
    "tags": [
        "work-items",
        "quality",
        "boards",
        "sprints",
        "backlog",
        "analysis",
        "best-practices"
    ],
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "icons": {
        "default": "static/icon.png"
    },
    "screenshots": [
        { "path": "static/screenshots/overview.png" },
        { "path": "static/screenshots/violations.png" },
        { "path": "static/screenshots/sprints.png" },
        { "path": "static/screenshots/settings.png" }
    ],
    "content": {
        "details": {
            "path": "overview.md"
        },
        "license": {
            "path": "LICENSE"
        }
    },
    "links": {
        "repository": {
            "uri": "https://github.com/adam-wheater/azure-devops-work-item-quality"
        },
        "issues": {
            "uri": "https://github.com/adam-wheater/azure-devops-work-item-quality/issues"
        },
        "support": {
            "uri": "https://github.com/adam-wheater/azure-devops-work-item-quality/issues"
        }
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/adam-wheater/azure-devops-work-item-quality"
    },
    "branding": {
        "color": "#0078d4",
        "theme": "dark"
    },
    "galleryFlags": [
        "Preview"
    ],
    "contributions": [
        {
            "id": "work-item-quality-hub",
            "type": "ms.vss-web.hub",
            "description": "Work Item Quality Analyzer hub under Boards",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Work Item Quality",
                "order": 99,
                "uri": "dist/WorkItemQualityHub/WorkItemQualityHub.html",
                "icon": {
                    "light": "static/icon.png",
                    "dark": "static/icon.png"
                }
            }
        }
    ],
    "scopes": [
        "vso.work",
        "vso.extension.data",
        "vso.project"
    ],
    "demands": [],
    "files": [
        {
            "path": "dist",
            "addressable": true
        },
        {
            "path": "static",
            "addressable": true
        },
        {
            "path": "overview.md",
            "addressable": true
        },
        {
            "path": "LICENSE",
            "addressable": true
        }
    ]
}
